// Skema data MING SOP Center.
// Keputusan utama: Sop memegang status alur kerja, SopVersion memegang isi + status
// publikasinya. Versi terbit jadi immutable tanpa menduplikasi metadata SOP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  KARYAWAN
  PIC_SOP
  MANAGER
  HRD
  AUDITOR
  MANAJEMEN
}

enum SopStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum SopVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  PUBLISH
}

enum ReportStatus {
  OPEN
  TRIAGED
  INVESTIGATING
  RESOLVED
  CLOSED
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  users     User[]
  sops      Sop[]
  createdAt DateTime @default(now())

  @@map("departments")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  departmentId String?  @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  department       Department?      @relation(fields: [departmentId], references: [id])
  ownedSops        Sop[]            @relation("SopOwner")
  createdVersions  SopVersion[]     @relation("VersionAuthor")
  publishedVersions SopVersion[]    @relation("VersionPublisher")
  approvals        SopApproval[]
  acknowledgements Acknowledgement[]
  announcements    Announcement[]
  reportsFiled     ViolationReport[] @relation("ReportReporter")
  reportsAssigned  ViolationReport[] @relation("ReportAssignee")
  followUps        ReportFollowUp[]
  auditLogs        AuditLog[]

  @@index([departmentId])
  @@map("users")
}

model Sop {
  id                      String    @id @default(uuid())
  code                    String    @unique
  title                   String
  summary                 String    @default("")
  departmentId            String    @map("department_id")
  ownerId                 String    @map("owner_id")
  status                  SopStatus @default(DRAFT)
  requiresAcknowledgement Boolean   @default(false) @map("requires_acknowledgement")
  reviewPeriodMonths      Int       @default(12) @map("review_period_months")
  currentVersionId        String?   @unique @map("current_version_id")
  nextReviewAt            DateTime? @map("next_review_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  department     Department        @relation(fields: [departmentId], references: [id])
  owner          User              @relation("SopOwner", fields: [ownerId], references: [id])
  currentVersion SopVersion?       @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       SopVersion[]      @relation("SopVersions")
  announcements  Announcement[]
  reports        ViolationReport[]

  @@index([departmentId, status])
  @@index([status])
  @@map("sops")
}

model SopVersion {
  id            String           @id @default(uuid())
  sopId         String           @map("sop_id")
  versionNo     Int              @map("version_no")
  content       String
  changeSummary String           @default("") @map("change_summary")
  status        SopVersionStatus @default(DRAFT)
  effectiveDate DateTime?        @map("effective_date")
  createdById   String           @map("created_by_id")
  publishedById String?          @map("published_by_id")
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  sop           Sop               @relation("SopVersions", fields: [sopId], references: [id], onDelete: Cascade)
  currentFor    Sop?              @relation("CurrentVersion")
  createdBy     User              @relation("VersionAuthor", fields: [createdById], references: [id])
  publishedBy   User?             @relation("VersionPublisher", fields: [publishedById], references: [id])
  approvals     SopApproval[]
  acknowledgements Acknowledgement[]

  @@unique([sopId, versionNo])
  @@index([sopId])
  @@map("sop_versions")
}

model SopApproval {
  id           String         @id @default(uuid())
  sopVersionId String         @map("sop_version_id")
  actorId      String         @map("actor_id")
  action       ApprovalAction
  note         String         @default("")
  createdAt    DateTime       @default(now()) @map("created_at")

  sopVersion SopVersion @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id])

  @@index([sopVersionId, createdAt])
  @@map("sop_approvals")
}

model Acknowledgement {
  id             String   @id @default(uuid())
  sopVersionId   String   @map("sop_version_id")
  userId         String   @map("user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  sopVersion SopVersion @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([sopVersionId, userId])
  @@index([userId])
  @@map("acknowledgements")
}

model Announcement {
  id                 String   @id @default(uuid())
  title              String
  body               String
  sopId              String?  @map("sop_id")
  targetDepartmentId String?  @map("target_department_id")
  createdById        String   @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")

  sop        Sop? @relation(fields: [sopId], references: [id], onDelete: SetNull)
  createdBy  User @relation(fields: [createdById], references: [id])

  @@index([createdAt])
  @@map("announcements")
}

model ViolationReport {
  id           String       @id @default(uuid())
  reporterId   String?      @map("reporter_id")
  sopId        String?      @map("sop_id")
  description  String
  status       ReportStatus @default(OPEN)
  assignedToId String?      @map("assigned_to_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  reporter   User?  @relation("ReportReporter", fields: [reporterId], references: [id])
  assignedTo User?  @relation("ReportAssignee", fields: [assignedToId], references: [id])
  sop        Sop?   @relation(fields: [sopId], references: [id], onDelete: SetNull)
  followUps  ReportFollowUp[]

  @@index([status])
  @@map("violation_reports")
}

model ReportFollowUp {
  id         String       @id @default(uuid())
  reportId   String       @map("report_id")
  actorId    String       @map("actor_id")
  fromStatus ReportStatus @map("from_status")
  toStatus   ReportStatus @map("to_status")
  note       String
  createdAt  DateTime     @default(now()) @map("created_at")

  report ViolationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User            @relation(fields: [actorId], references: [id])

  @@index([reportId, createdAt])
  @@map("report_follow_ups")
}

// Append-only. entityId sengaja tanpa foreign key agar riwayat tidak ikut terhapus.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
